{
  "name": "cims-microservice",
  "version": "1.0.0",
  "description": "CIMS Microservices Architecture",
  "private": true,
  "scripts": {
    "start": "npm run dev:all",
    "migration": "node scripts/migration/main.js",
    "dev:gateway": "npm run start:dev -w services/gateway",
    "dev:user": "npm run start:dev -w services/user-service",
    "dev:product": "npm run start:dev -w services/product-service",
    "dev:inventory": "npm run start:dev -w services/inventory-service",
    "dev:shopify": "npm run start:dev -w services/shopify-service",
    "dev:marketplace": "npm run start:dev -w services/marketplace-service",
    "dev:audit": "npm run start:dev -w services/audit-service",
    "dev:order": "npm run start:dev -w services/order-service",
    "dev:notification": "npm run start:dev -w services/notification-service",
    "dev:frontend": "npm run dev -w frontend",
    "dev:all": "concurrently --kill-others \"npm run dev:gateway\" \"npm run dev:user\" \"npm run dev:product\" \"npm run dev:inventory\" \"npm run dev:shopify\" \"npm run dev:marketplace\" \"npm run dev:audit\" \"npm run dev:order\" \"npm run dev:notification\" \"npm run dev:frontend\""
  },
  "workspaces": [
    "services/*",
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "weMonks Team",
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
